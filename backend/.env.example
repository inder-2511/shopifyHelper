PORT=5000

# Shopify Partners login (only used by local Playwright automation).
USER_EMAIL=
USER_PASSWORD=

# Shopify REST API version used when creating orders via SDK.
SHOPIFY_API_VERSION=2024-10

# Deployment flags — set both on Render, leave unset locally.
# Comma-separated list of allowed frontend origins. Example:
#   FRONTEND_ORIGIN=https://your-app.vercel.app
FRONTEND_ORIGIN=
# Set to "true" on Render to return 501 for Playwright-driven routes.
DISABLE_LOCAL_FEATURES=
