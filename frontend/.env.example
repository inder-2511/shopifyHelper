# Backend base URL. Locally leave unset (defaults to http://localhost:5000).
# On Vercel, set to your Render service URL, e.g. https://shopify-helper-api.onrender.com
VITE_API_URL=

# Set to "true" on Vercel to hide Playwright-only pages (Create Store, Store Setup).
# Leave unset locally so all features remain visible.
VITE_HIDE_LOCAL_FEATURES=
